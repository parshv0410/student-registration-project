<!DOCTYPE html>
<html>

<head>

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

<div class="container mt-5">

    <h1 class="mb-4 text-center">
        User Dashboard
    </h1>

    <table class="table table-bordered">

        <tr>
            <th>Name</th>
            <th>Email</th>
        </tr>

        <% users.forEach(user => { %>

        <tr>

        <td><%= user.name %></td>
        <td><%= user.email %></td>

        <td>
        <a href="/delete/<%= user._id %>" class="btn btn-danger btn-sm">
            Delete
        </a>
        </td>

        </tr>

        <% }) %>

    </table>

</div>

</body>

</html>